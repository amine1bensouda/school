# PostgreSQL dédié au site gratuit (projet Supabase séparé de quiz-main recommandé)
# Local : postgresql://postgres:VOTRE_MDP@localhost:5432/the_school
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Admin authentication
# Préférer ADMIN_PASSWORD_HASH (bcrypt). Générer avec: npm run admin:hash -- "your-password"
# ADMIN_PASSWORD reste supporté en fallback (dev uniquement, à ne PAS utiliser en prod).
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Secret pour signer le cookie de session admin (HMAC). Chaîne aléatoire longue.
ADMIN_SESSION_SECRET=

# E-mail — confirmation d'inscription (anti-spam)
# Ex. Gmail : smtp.gmail.com / port 587 + mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@schoolofmathematics.com

# Cloudflare R2 (S3 compatible)
R2_ACCOUNT_ID=
# Optional override (sinon construit avec R2_ACCOUNT_ID)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom domain or R2.dev public URL, without trailing slash
R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------------
# Réception sync depuis quiz-main (site payant)
# SYNC_API_KEY = FREE_SYNC_API_KEY (quiz-main)
# SYNC_HMAC_SECRET = FREE_SYNC_HMAC_SECRET (quiz-main)
# ------------------------------------------------------------------
SYNC_API_KEY=
SYNC_HMAC_SECRET=
