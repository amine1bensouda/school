# PostgreSQL dédié au site gratuit (projet Supabase séparé de quiz-main recommandé)
# Local : postgresql://postgres:VOTRE_MDP@localhost:5432/the_school
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7KTJELDY2Z

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-9022941899300098
# Remplacer par vos vrais ad units une fois créés dans AdSense
NEXT_PUBLIC_ADSENSE_DISPLAY_SLOT=
NEXT_PUBLIC_ADSENSE_INARTICLE_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=

# Admin authentication
# Préférer ADMIN_PASSWORD_HASH (bcrypt). Générer avec: npm run admin:hash -- "your-password"
# ADMIN_PASSWORD reste supporté en fallback (dev uniquement, à ne PAS utiliser en prod).
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Secret pour signer le cookie de session admin (HMAC). Chaîne aléatoire longue.
ADMIN_SESSION_SECRET=
USER_SESSION_SECRET=

# E-mail — confirmation d'inscription (anti-spam)
# Recommandé en production (VPS) : Resend — pas de port SMTP bloqué
# 1. Créer un compte sur https://resend.com
# 2. Vérifier le domaine theschoolofmathematics.com
# 3. Générer une clé API
RESEND_API_KEY=
RESEND_FROM=The School of Mathematics <noreply@theschoolofmathematics.com>

# Domaine d'envoi : doit être vérifié dans Resend (SPF + DKIM + DMARC)
# sinon Gmail met les messages en Spam.

# Boîtes qui reçoivent le formulaire /contact-us (séparées par des virgules)
CONTACT_INBOX_EMAIL=contact@schoolofmathematics.com,mdz.dev57@gmail.com

# Google reCAPTCHA v3 (formulaire de contact)
# Créer les clés sur https://www.google.com/recaptcha/admin (type reCAPTCHA v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score minimum accepté (0.0–1.0, défaut 0.5)
RECAPTCHA_MIN_SCORE=0.5

# Alternative : SMTP classique (souvent bloqué sur VPS — ports 587/465)
# Ex. Gmail : smtp.gmail.com / port 587 + mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@theschoolofmathematics.com
# Optionnel : IP IPv4 fixe si le VPS n'a pas IPv6 (sinon résolution auto)
# SMTP_HOST_IPV4=

# Cloudflare R2 (S3 compatible)
R2_ACCOUNT_ID=
# Optional override (sinon construit avec R2_ACCOUNT_ID)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom domain or R2.dev public URL, without trailing slash
R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------------
# Réception sync depuis quiz-main (site payant)
# SYNC_API_KEY = FREE_SYNC_API_KEY (quiz-main)
# SYNC_HMAC_SECRET = FREE_SYNC_HMAC_SECRET (quiz-main)
# ------------------------------------------------------------------
SYNC_API_KEY=
SYNC_HMAC_SECRET=
